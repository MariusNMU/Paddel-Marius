{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --port 4200",
    "start:backend:e2e": "node scripts/start-backend-e2e.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cypress:open": "start-server-and-test start http-get://localhost:4200 \"cypress open\"",
    "cypress:run": "start-server-and-test start http-get://localhost:4200 \"cypress run\"",
    "cypress:run:fullstack": "start-server-and-test start:backend:e2e http-get://localhost:8080/api/health start http-get://localhost:4200 \"cypress run --config-file cypress.fullstack.config.ts\""
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "cypress": "^15.18.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.11",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
